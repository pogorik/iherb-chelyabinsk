# Скопируйте этот файл в .env.local (он в .gitignore) и заполните значениями
# из Supabase → Settings → API вашего проекта.

# Публичные значения — безопасно использовать в клиентском коде,
# реальную защиту данных обеспечивают политики Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Только для локального запуска scripts/seed.ts — обходит Row Level Security,
# никогда не коммитьте и не используйте в клиентском коде.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
