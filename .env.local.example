# Скопируйте этот файл в .env.local (он в .gitignore) и заполните значениями.

# --- Timeweb Postgres ---
# Строка подключения к управляемой базе Timeweb (Dashboard → базы данных → PostgreSQL).
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Поставьте "false", только если подключаетесь без SSL (обычно не требуется).
DATABASE_SSL=true

# --- Timeweb S3-хранилище (фото товаров) ---
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=product-images
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
# Публичный базовый URL бакета (выдаётся при создании) — фото будут доступны по S3_PUBLIC_URL/<файл>.
S3_PUBLIC_URL=https://s3.twcstorage.ru/product-images

# --- Сессия админки ---
# Случайная строка 32+ символов, сгенерировать один раз и не менять
# (иначе разлогинит всех админов). Например: openssl rand -base64 32
SESSION_SECRET=
# "true" только после того, как настроен домен и HTTPS-сертификат — до этого
# должно быть пусто/false, иначе браузер не сохранит куку сессии по http.
COOKIE_SECURE=false

# --- Только на время миграции данных со старого Supabase-проекта ---
# Нужны исключительно для scripts/migrate-to-timeweb.ts и
# scripts/migrate-storage-to-s3.ts, после переноса можно удалить.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
